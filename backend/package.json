{
  "name": "hairvelous-backend",
  "version": "1.0.0",
  "description": "Hairvelous API - Hair Care and Product Recommendation System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "setup": "node scripts/setup-local.js",
    "db:bootstrap": "node scripts/bootstrap-db.js",
    "db:seed": "node scripts/seed-db.js",
    "db:sync-core-products": "node scripts/sync-core-products.js",
    "db:prepare-defense-demo": "node scripts/prepare-defense-demo.js",
    "db:fix-products-columns": "node scripts/fix-products-columns.js",
    "db:fix-hair-photos": "node scripts/fix-hair-photos-table.js",
    "db:fix-hair-assessment": "node scripts/fix-hair-assessment-tables.js",
    "db:fix-hair-profiles": "node scripts/fix-hair-profiles-table.js",
    "db:fix-product-categories": "node scripts/fix-product-categories-table.js",
    "seed:demo-specialist": "node scripts/seed-demo-specialist.js",
    "paymongo:webhook": "node scripts/register-paymongo-webhook.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "firebase-admin": "^13.6.1",
    "google-auth-library": "^9.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.5",
    "nodemailer": "^8.0.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.1.3"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/",
      "/config/"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "services/**/*.js",
      "controllers/**/*.js",
      "middleware/**/*.js",
      "routes/**/*.js",
      "!**/node_modules/**"
    ]
  }
}

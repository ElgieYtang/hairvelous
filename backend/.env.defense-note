# Hairvelous defense demo - offline assistant settings
#
# Copy these values into backend/.env for demo day.
# Restart backend after updating env values.

ENABLE_OFFLINE_CHATBOT=true

# Trigger AI when specialist has been offline for ~30 seconds
OFFLINE_SPECIALIST_MINUTES=0.5

# Avoid repeated AI replies too frequently
OFFLINE_CHATBOT_COOLDOWN_MINUTES=1

# Treat specialist as online only while recent presence pings are fresh
SPECIALIST_ONLINE_WINDOW_SECONDS=20

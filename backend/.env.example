# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=hairvelous
DB_CONNECTION_LIMIT=10

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=3000
NODE_ENV=development
# Auto DB bootstrap/seed on server startup (recommended true for dev/demo; false for production).
AUTO_BOOTSTRAP_DB_ON_START=true
AUTO_SEED_DB_ON_START=true

# Public URL of this app (used for PayMongo success/cancel redirects). Required in production.
# Example: https://yourdomain.com
APP_PUBLIC_URL=http://localhost:3000

# SMTP (for forgot-password reset emails)
# Example (Gmail app password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM=Hairvelous <your-email@gmail.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Firebase Admin credentials path (required for Firebase Google Sign-In endpoint /api/auth/google/firebase)
# Use absolute path OR path relative to backend/ folder.
# Example: GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GOOGLE_APPLICATION_CREDENTIALS=

# PayMongo (https://dashboard.paymongo.com) — optional; enables online pay + QR Ph on consultations.
# Use sk_test_... for development, sk_live_... in production.
PAYMONGO_SECRET_KEY=
# Payment mode for consultations:
# - demo: use fake payment submissions (no real money)
# - live: real gateway/manual proofs
PAYMENT_MODE=demo
# Consultation platform commission percent (specialist receives net after deduction)
PLATFORM_CONSULTATION_FEE_PERCENT=10
# Hosted checkout: comma-separated method types (gcash, card, paymaya, grab_pay, qrph, …).
PAYMONGO_PAYMENT_METHODS=gcash,card,paymaya
# Webhook URL (same for all events): https://YOUR_HOST/api/webhooks/paymongo
# Subscribe to: checkout_session.payment.paid AND payment.paid (QR Ph uses Payment Intents).
# Secret from Dashboard → your webhook → Show Secret (verifies Paymongo-Signature; recommended in production).
# Or run from backend/: npm run paymongo:webhook  (uses WEBHOOK_PUBLIC_BASE or APP_PUBLIC_URL for the callback URL).
PAYMONGO_WEBHOOK_SECRET=
# Optional: override public origin only when running paymongo:webhook (e.g. https://abc.ngrok-free.app)
# WEBHOOK_PUBLIC_BASE=

# File Upload Configuration
UPLOAD_DIR=../uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpeg,jpg,png,gif,webp
